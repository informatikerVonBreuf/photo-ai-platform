# Replace every value marked change-me before a real deployment.
FRONTEND_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
EMBEDDING_PORT=8001

POSTGRES_PASSWORD=change-me
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=photos_tinyclip_v1
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=photo_ai
MINIO_ROOT_PASSWORD=change-me-now

LOG_LEVEL=INFO
VLM_ENABLED=false
EMBEDDING_SERVICE_ENABLED=true

# Local embedding profile. TinyCLIP is the lightweight candidate; no model is
# downloaded automatically at runtime.
EMBEDDING_RUNTIME=transformers_clip
EMBEDDING_MODEL_NAME=wkcn/TinyCLIP-ViT-8M-16-Text-3M-YFCC15M
EMBEDDING_MODEL_REVISION=a2a8c6eaa2549ad66eb7c31b85022bf58273a26c
EMBEDDING_MODEL_HOST_PATH=./models/tinyclip
TEXT_VECTOR_SCORE_THRESHOLD=0.28
TEXT_VECTOR_RELATIVE_MARGIN=0.06
IMAGE_VECTOR_SCORE_THRESHOLD=0.40

# Optional CPU VLM profile. The files must exist in models/smolvlm/.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b9445
VLM_MODEL_HOST_PATH=./models/smolvlm
VLM_MODEL_FILE=SmolVLM-500M-Instruct-Q8_0.gguf
VLM_MMPROJ_FILE=mmproj-SmolVLM-500M-Instruct-Q8_0.gguf
VLM_MODEL_ALIAS=smolvlm-500m
VLM_JUDGE_BATCH_SIZE=1
VLM_RELEVANCE_THRESHOLD=0.70
VLM_TIMEOUT_SECONDS=240
VLM_COOLDOWN_SECONDS=90
VLM_CONTEXT_SIZE=4096
VLM_PARALLEL=1
VLM_CACHE_RAM_MB=0
VLM_IMAGE_MAX_TOKENS=384
VLM_IMAGE_MIN_TOKENS=384
